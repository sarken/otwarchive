<%= metadata_label(Work.human_attribute_name("chapter_total_display"))%>
<%= chapter_total_display(work) %><br />
<%= metadata_label(t("activerecord.models.fandom", count: work.tag_groups["Fandom"].size)) %>
<%= work.tag_groups["Fandom"].map { |fandom| link_to fandom.name, tag_url(fandom) }.join(t("support.array.words_connector")).html_safe %><br />
<% [Rating, ArchiveWarning, Relationship, Character, Freeform].each do |klass| %>
<% if (tags = work.tag_groups[klass.to_s]).present? %>
<%= tag_metadata(work.tag_groups[klass.to_s]) %>
<br />
<% end %>
<% end %>
<% if work.series.exists? %>
<%= metadata_label(Series.model_name.human(count: work.series.count)) %>
<%= series_list_with_work_position(work) %><br />
<% end %>
<% if work.summary.present? %>
<%= metadata_label(Work.human_attribute_name("summary"))%>
<%= sanitize_field(work, :summary).html_safe %>
<% end %>

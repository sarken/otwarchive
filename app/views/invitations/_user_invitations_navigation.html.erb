<% if logged_in? || policy(User).can_manage_users? %>
  <ul class="navigation actions">
    <% unless logged_in_as_admin? %>
      <li><%= span_if_current ts("Invitations"), user_invitations_path(@user) %></li>
    <% end %>
    <li><%= span_if_current ts("Manage Invitations"), manage_user_invitations_path(@user) %></li>
    <% unless logged_in_as_admin? %>
      <li><%= span_if_current ts("Request Invitations"), new_user_invite_request_path %></li>
    <% end %>
  </ul>
<% end %>
